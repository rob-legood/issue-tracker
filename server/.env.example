# development, test or production. Defaults to development. In production
# MONGODB_URI is required: the in-memory database is never used.
# NODE_ENV=development

# Port the API listens on.
PORT=3000

# MongoDB connection string. Leave unset in development to use an
# in-memory database (data is lost when the server stops).
# MONGODB_URI=mongodb://localhost:27017/issue-tracker
